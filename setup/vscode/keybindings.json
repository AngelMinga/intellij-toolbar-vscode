    { "key": "shift+cmd+a", "command": "workbench.action.showCommands" },
    { "key": "cmd+1", "command": "workbench.view.explorer" },
    { "key": "alt+cmd+y", "command": "workbench.action.files.revert" },
    { "key": "ctrl+cmd+f", "command": "workbench.action.toggleFullScreen" },
    { "key": "ctrl+`", "command": "workbench.action.selectTheme" },
    { "key": "cmd+,", "command": "workbench.action.openSettings" },
    { "key": "cmd+;", "command": "workbench.action.openWorkspaceSettings" },
    { "key": "f12", "command": "workbench.action.togglePanel" },
    { "key": "shift+escape", "command": "workbench.action.closePanel", "when": "panelFocus" },
    { "key": "shift+cmd+f12", "command": "workbench.action.maximizeEditorHideSidebar" },
    { "key": "shift+cmd+]", "command": "workbench.action.nextEditor" },
    { "key": "shift+cmd+[", "command": "workbench.action.previousEditor" },
    { "key": "escape", "command": "workbench.action.focusActiveEditorGroup", "when": "sideBarFocus" },
    { "key": "cmd+w", "command": "workbench.action.closeActiveEditor" },

