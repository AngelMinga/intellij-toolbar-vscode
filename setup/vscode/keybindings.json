    { "key": "ctrl+shift+space", "command": "editor.action.triggerSuggest", "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly" },
    { "key": "ctrl+alt+space", "command": "editor.action.triggerSuggest", "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly" },
    { "key": "cmd+p", "command": "editor.action.triggerParameterHints", "when": "editorHasSignatureHelpProvider && editorTextFocus" },
    { "key": "alt+space", "command": "editor.action.peekDefinition", "when": "editorHasDefinitionProvider && editorTextFocus" },
    { "key": "f1", "command": "editor.action.showHover", "when": "editorTextFocus" },
