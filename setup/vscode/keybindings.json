    { "key": "ctrl+cmd+r", "command": "testing.reRunLastRun" },
    { "key": "shift+cmd+;", "command": "testing.showMostRecentOutput" },
    { "key": "shift+cmd+t", "command": "dart.goToTestOrImplementationFile", "when": "editorTextFocus && editorLangId == dart" },
    { "key": "alt+cmd+8", "command": "workbench.view.extension.test" },

    // ---------- REFACTOR AND CLEAN UP ----------
    { "key": "ctrl+t", "command": "editor.action.refactor", "when": "editorTextFocus && !editorReadonly" },
    { "key": "f5", "command": "filesExplorer.copy", "when": "explorerViewletFocus && !inputFocus" },
    { "key": "f6", "command": "renameFile", "when": "explorerViewletFocus && !inputFocus" },
    { "key": "cmd+delete", "command": "deleteFile", "when": "explorerViewletFocus && !inputFocus" },
    { "key": "shift+f6", "command": "editor.action.rename", "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly" },
    { "key": "shift+f6", "command": "renameFile", "when": "explorerViewletFocus && !inputFocus" },
    { "key": "cmd+f6", "command": "editor.action.refactor", "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+n", "command": "editor.action.codeAction", "args": { "kind": "refactor.inline" }, "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+m", "command": "editor.action.codeAction", "args": { "kind": "refactor.extract" }, "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+v", "command": "editor.action.codeAction", "args": { "kind": "refactor.extract" }, "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+f", "command": "editor.action.codeAction", "args": { "kind": "refactor.extract" }, "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+c", "command": "editor.action.codeAction", "args": { "kind": "refactor.extract" }, "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+p", "command": "editor.action.codeAction", "args": { "kind": "refactor.extract" }, "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+cmd+l", "command": "editor.action.formatDocument", "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly" }
