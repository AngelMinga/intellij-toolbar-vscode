// Keymap estilo IntelliJ IDEA (macOS) generado desde "IntelliJ IDEA-macOS copy-keymap.csv"
// Respaldo del archivo anterior: keybindings.backup-2026-11-11.json
[
    // ---------- Terminal (se conserva el existente) ----------
    { "key": "shift+enter", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b\r" }, "when": "terminalFocus" },
