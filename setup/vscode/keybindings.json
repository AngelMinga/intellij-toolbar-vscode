    { "key": "cmd+t", "command": "git.pull" },
    { "key": "alt+shift+c", "command": "timeline.focus" },
    { "key": "alt+cmd+z", "command": "git.revertSelectedRanges", "when": "editorTextFocus && !editorReadonly" },
    { "key": "shift+cmd+k", "command": "git.push" },
    { "key": "ctrl+alt+shift+down", "command": "workbench.action.editor.nextChange", "when": "editorTextFocus" },
    { "key": "ctrl+alt+shift+up", "command": "workbench.action.editor.previousChange", "when": "editorTextFocus" },
    { "key": "cmd+0", "command": "workbench.view.scm" },

