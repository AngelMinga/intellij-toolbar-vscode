    { "key": "cmd+f", "command": "actions.find" },
    { "key": "cmd+r", "command": "editor.action.startFindReplaceAction" },
    { "key": "shift+cmd+f", "command": "workbench.action.findInFiles" },
    { "key": "shift+cmd+r", "command": "workbench.action.replaceInFiles" },
    { "key": "cmd+o", "command": "workbench.action.showAllSymbols" },
    { "key": "cmd+f12", "command": "workbench.action.gotoSymbol" },
    { "key": "shift+cmd+o", "command": "workbench.action.quickOpen" },
    { "key": "alt+cmd+o", "command": "workbench.action.showAllSymbols" },
    { "key": "alt+shift+cmd+e", "command": "workbench.action.quickTextSearch" },

    // ---------- NAVIGATE FROM SYMBOLS ----------
    { "key": "cmd+b", "command": "editor.action.revealDefinition", "when": "editorHasDefinitionProvider && editorTextFocus" },
    { "key": "shift+cmd+b", "command": "editor.action.goToTypeDefinition", "when": "editorTextFocus" },
    { "key": "cmd+u", "command": "dart.goToSuper", "when": "editorTextFocus && editorLangId == dart" },
    { "key": "alt+cmd+b", "command": "editor.action.goToImplementation", "when": "editorHasImplementationProvider && editorTextFocus" },
    { "key": "alt+f7", "command": "references-view.findReferences", "when": "editorHasReferenceProvider && editorTextFocus" },
    { "key": "shift+cmd+f7", "command": "editor.action.wordHighlight.trigger", "when": "editorTextFocus" },
    { "key": "alt+cmd+f7", "command": "editor.action.referenceSearch.trigger", "when": "editorHasReferenceProvider && editorTextFocus" },

    // ---------- NAVIGATE CONTEXT ----------
    { "key": "alt+f1", "command": "workbench.files.action.showActiveFileInExplorer" },
    { "key": "cmd+e", "command": "workbench.action.showAllEditorsByMostRecentlyUsed" },
    { "key": "shift+cmd+backspace", "command": "workbench.action.navigateToLastEditLocation" },
    { "key": "cmd+[", "command": "workbench.action.navigateBack" },
    { "key": "cmd+]", "command": "workbench.action.navigateForward" },
    { "key": "alt+cmd+left", "command": "workbench.action.navigateBack" },
    { "key": "alt+cmd+right", "command": "workbench.action.navigateForward" },
    // Recent Locations (⇧⌘E): VS Code no tiene la vista con fragmentos; cada pulsación retrocede por los lugares editados.
    { "key": "shift+cmd+e", "command": "workbench.action.navigateBackInEditLocations" },
    // Search Everywhere (doble Shift): el mismo panel que la lupa de la barra.
    { "key": "shift shift", "command": "workbench.action.quickOpenWithModes" },
