    { "key": "cmd+2", "command": "bookmarksExplorer.focus" },
    { "key": "cmd+8", "command": "workbench.view.debug" },
    // Bookmarks (extensión alefragnani.bookmarks): F3 marca/desmarca, ⌘F3 lista todos.
    { "key": "f3", "command": "bookmarks.toggle", "when": "editorTextFocus" },
    { "key": "cmd+f3", "command": "bookmarks.listFromAllFiles" },
    { "key": "cmd+l", "command": "workbench.action.gotoLine" },
    { "key": "alt+cmd+]", "command": "editor.action.jumpToBracket", "when": "editorTextFocus" },
    { "key": "alt+cmd+[", "command": "editor.action.jumpToBracket", "when": "editorTextFocus" },
    { "key": "cmd+g", "command": "editor.action.nextMatchFindAction", "when": "editorFocus" },
    { "key": "shift+cmd+g", "command": "editor.action.previousMatchFindAction", "when": "editorFocus" },
    { "key": "cmd+3", "command": "workbench.view.search" },
    { "key": "cmd+7", "command": "outline.focus" },

    // ---------- BUILD, RUN, AND DEBUG ----------
    { "key": "cmd+f9", "command": "workbench.action.tasks.build" },
    { "key": "shift+cmd+f9", "command": "workbench.action.tasks.runTask" },
    { "key": "ctrl+shift+r", "command": "workbench.action.debug.run", "when": "!terminalFocus" },
    // ⌃R / ⌃D / ⌃⌥R / ⌃⌥D usan la configuración elegida en la barra (extensión run-configurations).
    // ⌃R sobre algo ya corriendo hace Rerun, como IntelliJ.
    { "key": "ctrl+alt+r", "command": "runConfigurations.select", "when": "!terminalFocus" },
    { "key": "ctrl+alt+d", "command": "runConfigurations.select", "when": "!terminalFocus" },
    { "key": "ctrl+r", "command": "runConfigurations.run", "when": "!terminalFocus" },
    { "key": "ctrl+d", "command": "runConfigurations.debug", "when": "!terminalFocus" },
    { "key": "f8", "command": "workbench.action.debug.stepOver", "when": "inDebugMode" },
    { "key": "f7", "command": "workbench.action.debug.stepInto", "when": "inDebugMode" },
    { "key": "shift+f7", "command": "editor.debug.action.stepIntoTargets", "when": "inDebugMode" },
    { "key": "shift+f8", "command": "workbench.action.debug.stepOut", "when": "inDebugMode" },
    { "key": "alt+f9", "command": "editor.debug.action.runToCursor", "when": "inDebugMode && editorTextFocus" },
    { "key": "alt+cmd+f9", "command": "editor.debug.action.runToCursor", "when": "inDebugMode && editorTextFocus" },
    { "key": "alt+f10", "command": "workbench.debug.action.focusCallStackView", "when": "inDebugMode" },
    { "key": "alt+f8", "command": "editor.debug.action.selectionToRepl", "when": "inDebugMode && editorTextFocus" },
    { "key": "cmd+f2", "command": "runConfigurations.stop", "when": "runConfigurations.running" },
    { "key": "cmd+f2", "command": "workbench.action.debug.stop", "when": "inDebugMode && !runConfigurations.running" },
    { "key": "alt+cmd+r", "command": "workbench.action.debug.continue", "when": "inDebugMode" },
    { "key": "cmd+f8", "command": "editor.debug.action.toggleBreakpoint", "when": "editorTextFocus" },
    { "key": "shift+cmd+f8", "command": "editor.debug.action.conditionalBreakpoint", "when": "editorTextFocus" },
    { "key": "shift+cmd+f8", "command": "workbench.debug.action.focusBreakpointsView", "when": "!editorTextFocus" },
    { "key": "cmd+4", "command": "workbench.debug.action.toggleRepl" },
    { "key": "cmd+5", "command": "workbench.view.debug" },

