  "tokenColors": [
    {
      "name": "Default text",
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A7E85",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.triple-slash",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#5F826B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.javadoc",
        "comment.block.documentation keyword",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#67A37C",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Doc comment references",
      "scope": [
        "variable.other.documentation",
        "comment.block.documentation variable"
      ],
      "settings": {
        "foreground": "#ABADB3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other",
        "constant.language",
        "variable.language.this",
        "variable.language.super",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "string.interpolated punctuation",
        "meta.embedded.expression punctuation.definition",
        "string variable.parameter.dart"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2AACB8"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "variable.other.enummember",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations / metadata",
      "scope": [
        "storage.type.annotation",
        "meta.declaration.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "meta.decorator",
        "variable.other.annotation"
      ],
      "settings": {
        "foreground": "#B3AE60"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "storage.type.class.dart"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.parameter",
        "variable.type.parameter"
      ],
      "settings": {
        "foreground": "#16BAAC"
      }
    },
    {
      "name": "Fields / properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property-name",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#32B8AF"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#42C3D4"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "XML / HTML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D5B778"
      }
    },
    {
      "name": "XML / HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#73BD79"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#70AEFF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#BCBEC4",
    "enum": "#BCBEC4",
    "interface": "#BCBEC4",
    "mixin": "#BCBEC4",
    "typeAlias": "#BCBEC4",
    "type": "#BCBEC4",
    "extensionType": "#BCBEC4",
    "typeParameter": "#16BAAC",
    "namespace": "#BCBEC4",
    "parameter": "#BCBEC4",
    "variable": "#BCBEC4",
    "variable.static": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "variable.readonly.static": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "property": "#C77DBB",
    "property.static": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "enumMember": {
      "foreground": "#C77DBB",
      "italic": true
    },
